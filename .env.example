# ============ 全局开关 ============
# true: 所有外部服务(LLM/数字人/抖音/Perplexity)走 Mock 实现，无 key 也能跑通全链路
# false: 使用下方真实 key
MOCK_EXTERNAL=false

# ============ 数据库 / 队列 ============
DATABASE_URL=postgresql+psycopg://aigc:aigc@localhost:5432/aigc
REDIS_URL=redis://localhost:6379/0

# ============ LLM（内容生成 / 评论打标 / LLM-as-judge） ============
# 强推理模型：选题确认、脚本大纲（分层路由中的"重决策"通道）
LLM_STRONG_API_KEY=
LLM_STRONG_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_STRONG_MODEL=deepseek-v4-flash-ga-260731
# 高性价比模型：批量口播文案、标题、评论打标
LLM_LITE_API_KEY=
LLM_LITE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_LITE_MODEL=doubao-seed-2-0-lite-260428

# ============ GEO 跟踪 ============
PERPLEXITY_API_KEY=
GEO_MODELS=search-augmented,perplexity-sonar,doubao-web,kimi-web,deepseek-web
GEO_SAMPLES_PER_PROMPT=3
GEO_CONCURRENCY=5

# ---- GEO 搜索通道：不依赖 Perplexity 时的联网检索 + 结构化引用 ----
# SEARCH_PROVIDER 留空则按已填 key 自动挑选（优先级 zhipu > tavily > bocha）
# ZHIPU_SEARCH_ENGINE: search_std 0.01元/次 | search_pro 0.03元/次
# TAVILY_API_KEY 免费 1000 credits/月，无需信用卡，需海外网络
SEARCH_PROVIDER=
SEARCH_TOP_K=5
ZHIPU_API_KEY=
ZHIPU_SEARCH_ENGINE=search_std
TAVILY_API_KEY=
BOCHA_API_KEY=

# ============ 数字人 ============
# mock      ：内存 mock，无外部依赖（默认）
# sadtalker ：本地开源，零成本无额度上限，需 GPU + 本地部署（见 SADTALKER_DIR）
# aliyun    ：阿里云百炼万相 wan2.2-s2v，新用户 100 秒免费额度
# xfyun     ：讯飞数字人视频大模型，免费包 300 秒 / 7 天（主题驱动，自动扩写文案）
# silicon   ：硅基智能（商用，无免费额度）
AVATAR_PROVIDER=mock
AVATAR_VOICE_KEY=female_warm

# ---- 本地 SadTalker（推荐先试，完全不花钱）----
# 一次性部署：git clone https://github.com/OpenTalker/SadTalker
#             cd SadTalker && pip install -r requirements.txt
SADTALKER_DIR=
SADTALKER_PYTHON=
SADTALKER_EXTRA_ARGS=--still --preprocess full --enhancer gfpgan

# ---- 阿里云百炼 万相 wan2.2-s2v ----
# 注意：官方要求图片/音频均为公网可访问 URL，且单次音频 < 20 秒
#       （超长口播已实现自动分段 + 拼接）
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
WAN_RESOLUTION=480P
# 把 output/ 暴露到公网（隧道或对象存储）后填这里，本地素材会自动映射为公网 URL
MEDIA_PUBLIC_BASE=

# ---- 讯飞 数字人视频大模型（免费包 300 秒 / 7 天 / 并发 1）----
# 控制台 → 我的应用 → 对应服务详情页 获取三个凭证
# 注意：主题驱动，服务端自动扩写文案，不会精确播报本地生成的文案
XFYUN_APPID=
XFYUN_API_KEY=
XFYUN_API_SECRET=
XFYUN_BASE_URL=https://vms.cn-huadong-1.xf-yun.com
XFYUN_WORD_COUNT=0

# ---- 硅基智能（商用）----
SILICON_API_KEY=
SILICON_BASE_URL=https://api.siliconintelligent.com

# ============ 抖音开放平台 ============
DOUYIN_CLIENT_KEY=
DOUYIN_CLIENT_SECRET=
# 经营抖音号授权 token（bus_act.xxx 前缀）
DOUYIN_BUSINESS_TOKEN=

# ============ 工程参数 ============
# 采集/生成队列并发与限流
IO_QUEUE_CONCURRENCY=10
CPU_QUEUE_CONCURRENCY=3
LLM_TOKEN_BUDGET_DAILY=5000000
TRACE_ENABLED=true
